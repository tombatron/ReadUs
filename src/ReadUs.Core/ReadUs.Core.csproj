<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Writes CommandTableGenerator's output to disk for inspection/debugging. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ReadUs.Core</PackageId>
    <Version>0.1.0</Version>
    <Description>A from-scratch, low-allocation .NET Redis client: RESP3, Tier 1/Tier 2 connection pooling, blocking commands, transactions, and a zero-reflection source-generated command surface. Standalone-server support; see ReadUs.Cluster/ReadUs.Sentinel for Cluster/Sentinel.</Description>
    <PackageTags>redis;resp3;database;cache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReadUs.SourceGenerators\ReadUs.SourceGenerators.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The vendored command table CommandTableGenerator reads (project spec §3;
         see codegen/redis-commands/SOURCE.md for provenance). -->
    <AdditionalFiles Include="..\..\codegen\redis-commands\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ReadUs.Tests.Unit exercise internal types directly — specifically
         PendingRequest, for the exhaustive completion-claim state-space walker
         (docs/design/state-machines.md §2.6, project spec §9.1). -->
    <InternalsVisibleTo Include="ReadUs.Tests.Unit" />
  </ItemGroup>

</Project>
