<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ReadUs.Core\ReadUs.Core.csproj" />
    <ProjectReference Include="..\ReadUs.Cluster\ReadUs.Cluster.csproj" />
    <ProjectReference Include="..\ReadUs.Sentinel\ReadUs.Sentinel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ReadUs.Extensions.DependencyInjection</PackageId>
    <Version>0.1.0</Version>
    <Description>Microsoft.Extensions.DependencyInjection registration helpers for ReadUs's RedisClient, ClusterClient, and SentinelClient.</Description>
    <PackageTags>redis;dependencyinjection;database;cache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
